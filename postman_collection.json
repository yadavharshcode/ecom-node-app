    ],
    "variable": [
      {
        "key": "base_url",
        "value": "http://localhost:3000/api",
        "description": "Base URL for API requests"
      },
      {
        "key": "access_token",
        "value": "",
        "description": "JWT Access Token from login/register"
      },
      {
        "key": "refresh_token",
        "value": "",
        "description": "JWT Refresh Token from login/register"
      }
    ],
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "type": "text/javascript",
          "exec": [
            ""
          ]
        }
      },
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"Status code is 200\", function () {",
            "    pm.response.to.have.status(200);",
            "});",
            "",
            "// For successful auth requests, store tokens",
            "if (pm.response.code === 200 && pm.request.url.path.includes('auth')) {",
            "    const response = pm.response.json();",
            "    if (response.data.accessToken) {",
            "        pm.collectionVariables.set('access_token', response.data.accessToken);",
            "    }",
            "    if (response.data.refreshToken) {",
            "        pm.collectionVariables.set('refresh_token', response.data.refreshToken);",
            "    }",
            "}"
          ]
        }
      }
    ],
    "auth": null
  }